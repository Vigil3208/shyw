# 运行模式：auto 会根据 API Key 自动选择模型或本地模式
APP_MODEL_MODE=auto

# OpenAI 配置（与 LongCat 配置二选一）
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5-mini

# LongCat OpenAI 兼容接口配置（与 OpenAI 配置二选一）
LONGCAT_API_KEY=
LONGCAT_URL=https://api.longcat.chat/openai/v1
LONGCAT_MODEL=LongCat-2.0

APP_HOST=127.0.0.1
APP_PORT=8000
APP_DATA_DIR=data
APP_MAX_INPUT_CHARS=12000
APP_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MODEL_TIMEOUT_SECONDS=14
MODEL_MAX_RETRIES=0
